# PostgreSQL — use a unique production password on Contabo.
POSTGRES_DB=mechman
POSTGRES_USER=mechman
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql+asyncpg://mechman:replace-with-a-strong-database-password@postgres:5432/mechman

# Public HTTPS URLs.
APP_DOMAIN=crm.example.com
FRONTEND_ORIGIN=https://crm.example.com
PUBLIC_BOOKING_URL=https://crm.example.com/book
CORS_ORIGINS=https://crm.example.com

# Dashboard administrator.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRE_MINUTES=720
DASHBOARD_AUTH_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# Internal Mechman calendar.
MEETING_DURATION_MINUTES=60

# Official Meta WhatsApp Cloud API.
# The IDs below are non-secret production asset identifiers from the owner handoff.
META_PHONE_NUMBER_ID=1395187090344267
META_WABA_ID=29459993996925480
META_API_VERSION=v26.0
# Keep blank during CRM-only testing. Inject the owner-held values on the server
# only when WABA activation is explicitly approved.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
CAMPAIGN_POLL_SECONDS=10
MEDIA_ROOT=/app/media
MAX_MEDIA_BYTES=104857600

NOTIFICATION_POLL_SECONDS=30
LOG_LEVEL=INFO
LOG_FORMAT=json
SLOW_REQUEST_MS=1000
